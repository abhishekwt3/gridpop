{% schema %}
{
"name": "Exit Intent Discount Bar",
"target": "section",
"javascript": "exit-popup.js",
"stylesheet": "exit-popup.css",
"settings": [
 {
"type": "text",
"id": "bar_title",
"label": "Fallback Title",
"default": "Special Offer!"
 },
 {
"type": "text",
"id": "bar_message",
"label": "Fallback Discount Code",
"default": "SAVE10"
 },
 {
"type": "color",
"id": "bar_background",
"label": "Background Color",
"default": "#fffae6"
 }
 ]
}
{% endschema %}
{% assign popup_settings = shop.metafields.exitPopup.settings %}
{% if popup_settings == blank %}
 <script>
 console.error("Exit popup settings metafield not found!");
 window.exitIntentConfig = {
   displayType: "discount-bar",
   popupFrequency: 1,
   timerDuration: 15,
   discountCode: "SAVE10",
   offerText: "Special Offer!",
   buttonText: "Copy Code",
   scrollDetection: true,
   barPosition: "middle"
 };
 </script>
{% else %}
 {% assign popup_frequency = popup_settings | split: '"popupFrequency":"' | last | split: '"' | first %}
 {% assign popup_frequency_number = popup_frequency | times: 1 | default: 1 %}
 {% assign display_type = popup_settings | split: '"displayType":"' | last | split: '"' | first | default: "discount-bar" %}
 {% assign timer_duration = popup_settings | split: '"timerDuration":"' | last | split: '"' | first | default: "15" %}
 {% assign timer_duration_number = timer_duration | times: 1 | default: 15 %}
 {% assign background_color = popup_settings | split: '"backgroundColor":"' | last | split: '"' | first | default: "#ffffff" %}
 {% assign text_color = popup_settings | split: '"textColor":"' | last | split: '"' | first | default: "#333333" %}
 {% assign button_color = popup_settings | split: '"buttonColor":"' | last | split: '"' | first | default: "#4CAF50" %}
 {% assign heading = popup_settings | split: '"heading":"' | last | split: '"' | first | default: "Special Offer!" %}
 {% assign subtext = popup_settings | split: '"subtext":"' | last | split: '"' | first | default: "SAVE10" %}
 {% assign button_text = popup_settings | split: '"buttonText":"' | last | split: '"' | first | default: "Copy Code" %}
 {% assign scroll_detection = popup_settings | split: '"scrollDetection":' | last | split: ',' | first %}
 {% assign bar_position = popup_settings | split: '"barPosition":"' | last | split: '"' | first | default: "middle" %}
 <div id="discount-bar-container">
 <div id="discount-bar" class="discount-bar" style="display: none;">
 <div class="discount-bar__content" style="background-color: {{ background_color }}; color: {{ text_color }};">
 <div class="discount-bar__timer">
 <span id="discount-timer">{{ timer_duration }}:00</span>
 </div>
 <div class="discount-bar__message">
 <h2 style="color: {{ text_color }};" >{{ heading }}</h2>
 </div>
 <div class="discount-bar__action">
 <div class="discount-bar__copy-container">
 <span id="discount-code" class="discount-bar__code" style="color: {{ text_color }};">{{ subtext }}</span>
 <button type="button" id="copy-discount-button" class="discount-bar__copy-button" style="background-color: {{ button_color }};">{{ button_text }}</button>
 </div>
 </div>
 <button type="button" class="discount-bar__close" aria-label="Close discount bar">&times;</button>
 </div>
 </div>
 </div>
 <script>
 window.exitIntentConfig = {
   displayType: "discount-bar",
   popupFrequency: {{ popup_frequency_number }},
   timerDuration: {{ timer_duration_number }},
   discountCode: "{{ subtext }}",
   offerText: "{{ heading }}",
   buttonText: "{{ button_text }}",
   scrollDetection: {% if scroll_detection == "false" %}false{% else %}true{% endif %},
   barPosition: "{{ bar_position }}"
 };
 console.log("Exit Intent Config:", window.exitIntentConfig);
 </script>
{% endif %}
<script src="{{ 'exit-popup.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'exit-popup.css' | asset_url }}">